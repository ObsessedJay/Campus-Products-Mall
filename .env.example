# Spring Boot infrastructure
MYSQL_URL=jdbc:mysql://localhost:3306/campus_creative?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=change-me
MYSQL_PASSWORD=change-me
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=change-me
RABBITMQ_PASSWORD=change-me

# MinIO image storage. Keep disabled unless all credentials are configured.
MINIO_ENABLED=false
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=campus-creative
MAX_IMAGE_BYTES=5242880
MAX_IMAGE_DIMENSION=1920
JPEG_QUALITY=0.82
IMAGE_ORPHAN_RETENTION_HOURS=24
IMAGE_CLEANUP_SCAN_MS=3600000
PRODUCT_MAX_IMAGES=8
MAX_MULTIPART_FILE_SIZE=6MB
MAX_MULTIPART_REQUEST_SIZE=6MB

# QQ Mail SMTP. Use a QQ Mail authorization code, never the account password.
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=change-me@example.com
MAIL_PASSWORD=change-me

# Authentication verification windows
JWT_SECRET=replace-with-at-least-32-random-bytes
CAPTCHA_TTL_SECONDS=300
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_COOLDOWN_SECONDS=60
JWT_TOKEN_TTL=7200
REFRESH_TOKEN_TTL=604800
REFRESH_COOKIE_SECURE=false

# Redis-backed request guard
REQUEST_GUARD_ENABLED=true
AUTH_RATE_LIMIT=30
AUTH_RATE_WINDOW_SECONDS=60
WRITE_RATE_LIMIT=120
WRITE_RATE_WINDOW_SECONDS=60
FLASH_SALE_RATE_LIMIT=10
FLASH_SALE_RATE_WINDOW_SECONDS=1
LOGIN_FAILURE_LIMIT=5
LOGIN_BLOCK_SECONDS=900

# Student realtime status push
WEBSOCKET_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
ACTIVITY_STATE_SCAN_MS=10000
NOTIFICATION_ENABLED=true

# Optional Elasticsearch product search. MySQL remains the automatic fallback.
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_ENDPOINT=http://localhost:9200
ELASTICSEARCH_PRODUCT_INDEX=campus-products
